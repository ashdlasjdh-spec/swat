# ── Discord ────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications  (Bot > Reset Token)
DISCORD_TOKEN=

# ── Roblox ─────────────────────────────────────────────────
# Open Cloud API key (create at https://create.roblox.com/dashboard/credentials).
# Needs group:read + group:write, and the group permissions to accept join
# requests and manage ranks. Powers .accept / .acceptall / .setrank. KEEP SECRET.
ROBLOX_API_KEY=

# OPTIONAL — .ROBLOSECURITY cookie of a ranking account. Only needed for
# .exile and .ban (Open Cloud has no endpoint for those). Leave blank to
# disable those two commands. KEEP THIS SECRET.
ROBLOX_COOKIE=

# ── Groups (one bot, multiple groups, one prefix each) ─────
# Group 1  ("." -> Get swatted.gg)
GROUP_ID=981953580
PREFIX=.

# Group 2  ("," -> swatk raider tag). Set GROUP2_ID=0 to disable the 2nd group.
# NOTE: ROBLOX_API_KEY must be scoped to BOTH groups, and the cookie account
# must be a member of both with rank/exile/ban permission.
GROUP2_ID=807480487
PREFIX2=,

# Advanced: override everything with GROUPS="<prefix>:<groupId>,<prefix>:<groupId>"
# e.g. GROUPS=".:981953580,,:807480487"  (takes priority over the vars above)
# GROUPS=

# Comma-separated Discord role IDs allowed to use commands.
# Server admins / Manage-Server members are always allowed.
STAFF_ROLE_IDS=

# ── .verify role swap (Discord) ────────────────────────────
# Role GIVEN when a user is verified
VERIFIED_ROLE_ID=1521999556852711476
# Role REMOVED when a user is verified
UNVERIFIED_ROLE_ID=1522001263376597073

# Optional. Leave blank for a worker deploy. Railway sets PORT automatically
# for a web service; if set, a tiny keepalive HTTP server is started.
# PORT=
